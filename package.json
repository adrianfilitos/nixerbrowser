{
  "name": "navegador",
  "productName": "Nixer Browser",
  "version": "1.0.0",
  "description": "Navegador basado en Chromium con capa UI en React (arquitectura tipo Brave)",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "vite": "vite",
    "build": "vite build",
    "start": "npm run build && electron .",
    "icon": "node scripts/generate-icon.js",
    "dist": "npm run icon && npm run build && electron-builder --win nsis",
    "postdist": "node scripts/clean-unpacked.js",
    "dist:portable": "npm run icon && npm run build && electron-builder --win portable",
    "test:adblock": "electron electron/test-adblock.js",
    "test:filters": "electron electron/test-filters.js",
    "test:db": "electron electron/test-db.js",
    "test:shields": "electron electron/test-shields.js",
    "test:youtube": "electron electron/test-youtube.js",
    "test:uach": "electron electron/test-uach.js",
    "test:google": "electron electron/test-google.js",
    "test:auth-flow": "electron electron/test-auth-flow.js",
    "test:extensions": "electron electron/test-extensions.js",
    "test:newtab": "electron electron/test-newtab.js",
    "test:nixer": "electron electron/test-nixer.js",
    "test:browseraction": "electron electron/test-browseraction.js",
    "test:extmenu": "electron electron/test-extmenu.js",
    "test:tabs": "electron electron/test-tabs.js",
    "test:leak": "electron electron/test-leak.js",
    "test:features": "electron electron/test-features.js",
    "test:security": "electron electron/test-security.js",
    "test:incognito": "electron electron/test-incognito.js",
    "test:settings": "electron electron/test-settings.js",
    "test:ai": "electron electron/test-ai.js",
    "test:ux": "electron electron/test-ux.js",
    "test:features2": "electron electron/test-features2.js",
    "test:big": "electron electron/test-big.js",
    "test:translate": "electron electron/test-translate.js",
    "test:dock": "electron electron/test-dock.js",
    "test:drag": "electron electron/test-drag-real.js",
    "test:reorder": "electron electron/test-reorder.js",
    "test:tearoff": "electron electron/test-tearoff.js",
    "test:roundtrip": "electron electron/test-roundtrip.js",
    "test:error": "electron electron/test-error.js",
    "test:focus": "electron electron/test-focus.js",
    "test:cdp": "electron electron/test-cdp.js",
    "test:hint": "electron electron/test-hint.js",
    "test:gamepad": "electron electron/test-gamepad.js",
    "test:osk": "electron electron/test-osk.js",
    "test:overlay": "npm run build && electron electron/test-overlay.js",
    "test:nixer-private": "electron electron/test-nixer-private.js",
    "test:close": "electron electron/test-close.js",
    "test:ui": "electron electron/test-ui.js",
    "test:smoke": "npm run build && cross-env SMOKE=1 electron ."
  },
  "build": {
    "appId": "com.nixer.browser",
    "productName": "Nixer Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "pages/**/*",
      "newtab.html",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/nsis.nsh"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "electron-chrome-extensions": "^4.9.0",
    "electron-updater": "^6.8.9",
    "koffi": "^3.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.8",
    "wait-on": "^7.2.0"
  }
}
